# --- Nace (Drex + NDI) -------------------------------------------------
NACE_API_KEY=nace_sk_...
DREX_BASE_URL=https://drex.nace.ai        # confirm in console.nace.ai docs
DREX_PATH=/v1/systemone
DREX_AUTH_HEADER=Authorization            # sent as "Bearer <key>"; any other header name gets the raw key
DREX_MODEL=drex-latest
NDI_BASE_URL=                             # leave blank to use the local pypdf parser
NDI_EXTRACT_PATH=/v1/extract              # confirm in console.nace.ai docs

# --- DeepInfra (explanations + LLM baseline) ---------------------------
DEEPINFRA_API_KEY=...
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
EXPLAIN_MODEL=Qwen/Qwen3.8-27B
BASELINE_MODEL=<largest frontier model available on DeepInfra>
BASELINE_JSON_MODE=0                      # 1 = use response_format json_object
BASELINE_MAX_TOKENS=2048
VISION_MODEL=                             # optional: OCR fallback for photos when NDI is off

# --- Prices for the cost metric (USD) -- copy from the published pricing pages
BASELINE_PRICE_IN_PER_M=
BASELINE_PRICE_OUT_PER_M=
DREX_PRICE_PER_1K_CALLS=                  # or DREX_PRICE_IN_PER_M if Drex bills per token
DREX_PRICE_IN_PER_M=

# --- Keenable (optional key lifts the rate limit) ----------------------
KEENABLE_API_KEY=

# --- Dev ----------------------------------------------------------------
MOCK=0                                    # 1 = run fully offline with heuristics (never report these numbers)
